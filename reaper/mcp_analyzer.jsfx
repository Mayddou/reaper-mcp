desc:MCP Spectrum Analyzer
// Real-time FFT spectrum analyzer for MCP bridge integration.
// Writes frequency bin magnitudes (in dB) to shared memory (gmem)
// so the Lua bridge can read them and pass to the MCP server.
//
// Each instance writes to its own slot so several tracks can be metered at once.
// gmem layout (per track slot):
//   base = track_slot * 4104
//   gmem[base+0] = bin count (fft_size / 2)
//   gmem[base+1] = peak dB (max |L|,|R| over the last FFT frame)
//   gmem[base+2] = RMS dB (L+R power over the last FFT frame)
//   gmem[base+3] = sample rate the analyzer runs at
//   gmem[base+4] = FFT frames analysed since last reset (0 = no data yet)
//   gmem[base+5 .. base+5+bin_count-1] = magnitude in dB per frequency bin
//     (L/R power average; calibrated so a sine of amplitude A reads 20*log10(A))

options:gmem=MCPAnalyzer

slider1:fft_size_slider=4096<512,8192,1>FFT Size
slider2:window_type=1<0,3,1{Rectangular,Hann,Hamming,Blackman-Harris}>Window Function
slider3:smoothing=0.8<0,0.99,0.01>Smoothing
slider4:track_slot=0<0,1023,1>Track Slot

@init
  SLOT_STRIDE = 4104;
  // Memory map (fft_real buffers must not cross a 65536 boundary)
  window_buf = 0;          // window function (<= 8192)
  in_l = 8192;             // input ring, left
  in_r = 16384;            // input ring, right
  mag_buf = 24576;         // smoothed magnitudes in dB (<= 4096)
  work_l = 32768;          // FFT work buffer, left
  work_r = 49152;          // FFT work buffer, right

  fft_size = 0;            // forces setup in @slider

  function compute_window(size, wtype) (
    i = 0;
    window_sum = 0;
    loop(size,
      wtype == 0 ? (
        window_buf[i] = 1.0;
      ) : wtype == 1 ? (
        window_buf[i] = 0.5 * (1.0 - cos(2.0 * $pi * i / (size - 1)));
      ) : wtype == 2 ? (
        window_buf[i] = 0.54 - 0.46 * cos(2.0 * $pi * i / (size - 1));
      ) : (
        window_buf[i] = 0.35875
          - 0.48829 * cos(2.0 * $pi * i / (size - 1))
          + 0.14128 * cos(4.0 * $pi * i / (size - 1))
          - 0.01168 * cos(6.0 * $pi * i / (size - 1));
      );
      window_sum += window_buf[i];
      i += 1;
    );
  );

  function reset_analysis() (
    base = floor(track_slot + 0.5) * SLOT_STRIDE;
    fft_pos = 0;
    frames = 0;
    peak_val = 0;
    rms_sum = 0;
    rms_count = 0;
    gmem[base+0] = bin_count;
    gmem[base+1] = -150;
    gmem[base+2] = -150;
    gmem[base+3] = srate;
    gmem[base+4] = 0;
  );

@slider
  // Snap to a power of two between 512 and 8192
  fft_size = 2 ^ floor(log(max(512, min(8192, fft_size_slider))) / log(2) + 0.5);
  bin_count = fft_size / 2;
  compute_window(fft_size, window_type);
  reset_analysis();

@sample
  l = spl0;
  r = spl1;

  abs(l) > peak_val ? peak_val = abs(l);
  abs(r) > peak_val ? peak_val = abs(r);
  rms_sum += l * l + r * r;
  rms_count += 2;

  in_l[fft_pos] = l * window_buf[fft_pos];
  in_r[fft_pos] = r * window_buf[fft_pos];
  fft_pos += 1;

  fft_pos >= fft_size ? (
    memcpy(work_l, in_l, fft_size);
    memcpy(work_r, in_r, fft_size);
    fft_real(work_l, fft_size);
    fft_real(work_r, fft_size);
    fft_permute(work_l, fft_size / 2);
    fft_permute(work_r, fft_size / 2);

    // Amplitude calibration: fft_real bin magnitude = A * window_sum for a sine of
    // amplitude A, so dividing by window_sum makes a sine read its peak level
    scale = 1.0 / window_sum;
    smooth = frames == 0 ? 0 : smoothing; // first frame unsmoothed (no -150 dB start bias)

    i = 0;
    loop(bin_count,
      i == 0 ? (
        pl = work_l[0] * work_l[0];
        pr = work_r[0] * work_r[0];
        dc_scale = 0.5; // DC has no mirrored negative-frequency half
      ) : (
        pl = work_l[i * 2] * work_l[i * 2] + work_l[i * 2 + 1] * work_l[i * 2 + 1];
        pr = work_r[i * 2] * work_r[i * 2] + work_r[i * 2 + 1] * work_r[i * 2 + 1];
        dc_scale = 1;
      );
      magnitude = sqrt((pl + pr) * 0.5) * scale * dc_scale;
      magnitude < 0.000001 ? magnitude = 0.000001; // floor at -120 dB
      mag_db = 20.0 * log10(magnitude);

      mag_buf[i] = smooth * mag_buf[i] + (1 - smooth) * mag_db;
      gmem[base + 5 + i] = mag_buf[i];
      i += 1;
    );

    peak_val < 0.000001 ? peak_val = 0.000001;
    rms_val = rms_count > 0 ? sqrt(rms_sum / rms_count) : 0;
    rms_val < 0.000001 ? rms_val = 0.000001;

    frames += 1;
    gmem[base+0] = bin_count;
    gmem[base+1] = 20.0 * log10(peak_val);
    gmem[base+2] = 20.0 * log10(rms_val);
    gmem[base+3] = srate;
    gmem[base+4] = frames;

    peak_val = 0;
    rms_sum = 0;
    rms_count = 0;
    fft_pos = 0;
  );

  // Pass audio through unmodified
