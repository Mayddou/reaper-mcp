desc:MCP Crest Factor Meter
// Dynamic range meter via peak-to-RMS (crest factor) for MCP bridge integration.
// Measures peak level, RMS level, and their difference (crest factor) in dB.
// Higher crest factor = more dynamic (less compressed).
// Writes results to shared memory (gmem) so the Lua bridge can read them.
//
// Each instance writes to its own slot so several tracks can be metered at once.
// gmem layout (per track slot):
//   base = track_slot * 4
//   gmem[base+0] = crest factor (dB) = peak level - RMS level
//   gmem[base+1] = peak level (dB)
//   gmem[base+2] = RMS level (dB)
//   gmem[base+3] = measurement duration (seconds since last reset, 0 = no data yet)

options:gmem=MCPCrestFactor

slider1:window_ms=1000<100,5000,100>Window (ms)
slider2:peak_hold_ms=1000<100,10000,100>Peak Hold (ms)
slider3:track_slot=0<0,1023,1>Track Slot

@init
  // Ring buffer for squared samples (RMS window)
  buf_sq   = 0;      // per-sample L/R mean square
  buf_size = 0;      // set from sample rate at runtime
  buf_pos  = 0;
  sum_sq   = 0;

  // Peak hold
  peak_val     = 0;
  peak_hold_samples = 0;
  peak_hold_pos     = 0;

  needs_init = 1;

@slider
  needs_init = 1;

@sample
  needs_init ? (
    buf_size = ceil(srate * window_ms / 1000);
    buf_size > 262144 ? buf_size = 262144;
    buf_size < 1 ? buf_size = 1;
    memset(buf_sq, 0, buf_size);
    sum_sq = 0;
    buf_pos = 0;
    peak_val = 0;
    peak_hold_samples = ceil(srate * peak_hold_ms / 1000);
    peak_hold_pos = 0;
    sample_count = 0;
    needs_init = 0;
    base = floor(track_slot + 0.5) * 4;
    gmem[base+0] = 0;
    gmem[base+1] = -150;
    gmem[base+2] = -150;
    gmem[base+3] = 0;
  );

  // Per-channel metering (a mono sum would hide side/anti-phase content)
  sq   = (spl0 * spl0 + spl1 * spl1) * 0.5;
  peak_abs = max(abs(spl0), abs(spl1));

  // --- RMS ring buffer ---
  sum_sq -= buf_sq[buf_pos];
  buf_sq[buf_pos] = sq;
  sum_sq += sq;
  buf_pos += 1;
  buf_pos >= buf_size ? buf_pos = 0;
  sample_count += 1;

  // --- Peak hold ---
  peak_abs > peak_val ? (
    peak_val = peak_abs;
    peak_hold_pos = 0;
  ) : (
    peak_hold_pos += 1;
    peak_hold_pos >= peak_hold_samples ? (
      // Peak hold expired, decay toward current level
      peak_val *= 0.9999;
      peak_hold_pos = 0;
    );
  );

  // Update gmem every 512 samples
  (buf_pos % 512) == 0 ? (
    rms_val = sqrt(sum_sq / buf_size);

    rms_val > 0.000001 ? (
      rms_db = 20 * log10(rms_val);
    ) : (
      rms_db = -150;
    );

    peak_val > 0.000001 ? (
      peak_db = 20 * log10(peak_val);
    ) : (
      peak_db = -150;
    );

    // Crest factor = peak - RMS (both in dB)
    (rms_db > -150 && peak_db > -150) ? (
      crest_db = peak_db - rms_db;
      crest_db < 0 ? crest_db = 0; // should not happen but clamp for safety
    ) : (
      crest_db = 0;
    );

    gmem[base+0] = crest_db;
    gmem[base+1] = peak_db;
    gmem[base+2] = rms_db;
    gmem[base+3] = sample_count / srate;
  );

  // Pass audio through unmodified
